# Environment overrides for the agent command (NWORM_AGENT_*).
NWORM_AGENT_NAME="home"
NWORM_AGENT_IDENTITY="/etc/nworm/agent.key"
NWORM_AGENT_RELAYS="relay1.example.com:443,relay2.example.com:443"
NWORM_AGENT_REMOTE="127.0.0.1:22"
NWORM_AGENT_LOCAL="127.0.0.1:22"
NWORM_AGENT_KNOWN_HOSTS="/etc/nworm/known_hosts"
# NWORM_AGENT_INSECURE="false"
# NWORM_AGENT_KEEPALIVE="30s"
# Lists also accept JSON: NWORM_AGENT_RELAYS='["relay1:443","relay2:443"]'
