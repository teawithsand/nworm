# Environment overrides for the connect command (NWORM_CONNECT_*).
NWORM_CONNECT_ADMIN_USER="admin"
NWORM_CONNECT_IDENTITY="/home/user/.config/nworm/admin.key"
NWORM_CONNECT_KNOWN_HOSTS="/home/user/.config/nworm/known_hosts"
NWORM_CONNECT_RELAYS="relay1.example.com:443,relay2.example.com:443"
# NWORM_CONNECT_PORT="22"
# Maps are JSON: NWORM_CONNECT_DEST='{"home-rdp":3389}'
