# Environment overrides for the relay command (NWORM_RELAY_*).
# Precedence: default < file < env < explicit flag.
NWORM_RELAY_LISTEN=":443"
NWORM_RELAY_HOST_KEY="/etc/nworm/host.key"
NWORM_RELAY_KEEPALIVE="30s"
# Nested structures are JSON:
# NWORM_RELAY_AGENTS='{"home":{"keys":["ssh-ed25519 AAAA... agent@home"]}}'
# NWORM_RELAY_ADMINS='{"admin":{"keys":["ssh-ed25519 AAAA... admin@laptop"],"allow":["home"]}}'
